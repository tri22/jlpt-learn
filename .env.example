# Port của Nginx (load balancer) trên máy host
NGINX_PORT=8080

# Môi trường backend
APP_ENVIRONMENT=development
APP_DEBUG=true

# Redis
APP_REDIS_ENABLED=true

# Rate limit tầng ứng dụng (tầng Nginx nằm trong infra/nginx/conf.d/rate-limit.conf)
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_PER_MINUTE=60
APP_RATE_LIMIT_WRITE_PER_MINUTE=20

# CORS cho frontend
APP_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# Postgres
APP_DATABASE_URL=postgresql://jlpt:jlpt_dev_password@postgres:5432/jlpt
POSTGRES_USER=jlpt
POSTGRES_PASSWORD=jlpt_dev_password
POSTGRES_DB=jlpt
POSTGRES_PORT=5433

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
APP_MINIO_ENDPOINT=minio:9000
APP_MINIO_BUCKET=jlpt-media

# Mật khẩu Redis (nội bộ docker network)
REDIS_PASSWORD=jlpt_dev_password
